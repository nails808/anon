# Browser-visible (Vite). Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY

# Optional: if frontend is on a different origin than the Worker during local dev,
# point API calls at the Worker. Leave empty to use same-origin /api/* (production).
# VITE_API_BASE=
